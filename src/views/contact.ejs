<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>AllyAlways — Contact</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      height: 100%;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      background: #f0ece3;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 52px 24px 40px;
    }

    .heading {
      font-size: 32px;
      font-weight: 800;
      color: #111111;
      text-align: center;
      line-height: 1.2;
      letter-spacing: -0.5px;
      margin-bottom: 36px;
      max-width: 340px;
    }

    .buttons {
      width: 100%;
      max-width: 400px;
      display: flex;
      flex-direction: column;
      gap: 13px;
    }

    .link-btn {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
      padding: 0 20px;
      height: 58px;
      background: #ffffff;
      border: 1.8px solid #1a1a1a;
      border-radius: 100px;
      text-decoration: none;
      color: #111111;
      font-size: 16px;
      font-weight: 700;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      cursor: pointer;
    }
    .link-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0,0,0,0.12);
    }
    .link-btn:active {
      transform: translateY(0);
      box-shadow: none;
    }

    .icon-wrap {
      position: absolute;
      left: 18px;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .icon-wrap svg { width: 20px; height: 20px; display: block; }

    .btn-text {
      width: 100%;
      text-align: center;
    }

    .divider-wrap {
      width: 100%;
      max-width: 400px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 4px 0;
    }
    .divider-line { flex: 1; height: 1px; background: #d4cfc5; }
    .divider-text { font-size: 13px; color: #aaa; font-weight: 500; }

    .find-link {
      margin-top: 24px;
      font-size: 14px;
      font-weight: 600;
      color: #111;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }
    .find-link:hover { opacity: 0.6; }

    .empty {
      text-align: center; color: #bbb;
      margin-top: 60px; font-size: 14px; line-height: 2.4;
      max-width: 280px;
    }
    .empty strong { color: #6366f1; }
  </style>
</head>
<body>

  <div class="heading">ยินดีต้อนรับ!<br>ติดต่อเราได้เลย</div>

  <div class="buttons">

    <% if (links.length === 0) { %>
    <div class="empty">ยังไม่มีช่องทางติดต่อ<br>เพิ่มได้ที่ /admin<br>เลือก prefix: <strong>contact</strong></div>
    <% } %>

    <% links.forEach(function(link) {
      var s = link.slug.toLowerCase()
      var isFacebook   = s.includes('facebook') || s === 'fb'
      var isInstagram  = s.includes('instagram') || s === 'ig'
      var isTiktokShop = s.includes('tiktokshop') || s.includes('ttshop') || s.includes('tiktok-shop')
      var isTiktok     = !isTiktokShop && (s.includes('tiktok') || s === 'tt')
      var isShopee     = s.includes('shopee')
      var isLazada     = s.includes('lazada')
      var isLine       = s.includes('line')
      var isYoutube    = s.includes('youtube') || s === 'yt'
    %>

    <a href="<%= link.url %>" target="_blank" rel="noopener" class="link-btn">

      <% if (isFacebook) { %>
      <div class="icon-wrap" style="background:#1877f2">
        <svg viewBox="0 0 24 24" fill="white"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </div>

      <% } else if (isInstagram) { %>
      <div class="icon-wrap" style="background:radial-gradient(circle at 30% 107%,#fdf497 0%,#fd5949 45%,#d6249f 60%,#285aeb 90%)">
        <svg viewBox="0 0 24 24" fill="white"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </div>

      <% } else if (isTiktokShop) { %>
      <div class="icon-wrap" style="background:#ff6550">
        <svg viewBox="0 0 24 24" fill="white"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9.05a8.16 8.16 0 004.77 1.52V7.12a4.85 4.85 0 01-1-.43z"/></svg>
      </div>

      <% } else if (isTiktok) { %>
      <div class="icon-wrap" style="background:#010101">
        <svg viewBox="0 0 24 24" fill="white"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9.05a8.16 8.16 0 004.77 1.52V7.12a4.85 4.85 0 01-1-.43z"/></svg>
      </div>

      <% } else if (isShopee) { %>
      <div class="icon-wrap" style="background:#ee4d2d">
        <svg viewBox="0 0 50 50" fill="white"><path d="M25 3C15.06 3 7 11.06 7 21c0 4.38 1.58 8.39 4.19 11.5L8 46l13.33-4.44A17.87 17.87 0 0025 42c9.94 0 18-8.06 18-18S34.94 3 25 3zm0 5c7.18 0 13 5.82 13 13S32.18 34 25 34s-13-5.82-13-13 5.82-13 13-13zm-5.5 8a1.5 1.5 0 000 3h.09A5.51 5.51 0 0025 24.5 5.51 5.51 0 0030.41 19h.09a1.5 1.5 0 000-3h-11z"/></svg>
      </div>

      <% } else if (isLazada) { %>
      <div class="icon-wrap" style="background:#f57224">
        <svg viewBox="0 0 24 24" fill="white"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/></svg>
      </div>

      <% } else if (isLine) { %>
      <div class="icon-wrap" style="background:#06c755">
        <svg viewBox="0 0 24 24" fill="white"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.070 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
      </div>

      <% } else if (isYoutube) { %>
      <div class="icon-wrap" style="background:#ff0000">
        <svg viewBox="0 0 24 24" fill="white"><path d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
      </div>

      <% } else { %>
      <div class="icon-wrap" style="background:#6366f1">
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
      </div>
      <% } %>

      <span class="btn-text"><%= link.label || link.slug %></span>
    </a>

    <% }) %>

  </div>

  <% if (links.length > 0) { %>
  <a href="/" class="find-link">allyalways.com</a>
  <% } %>

</body>
</html>
