<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>AllyAlways — Contact</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      background: #f0ece3;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Hero: tall section for logo + heading, clips parallax */
    .hero {
      height: 52vh;
      min-height: 260px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .hero-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      will-change: transform;
      padding: 0 24px;
    }

    .logo {
      margin-bottom: 24px;
    }
    .logo svg {
      width: 140px;
      height: auto;
      display: block;
    }

    .heading {
      font-size: 30px;
      font-weight: 800;
      color: #111;
      text-align: center;
      line-height: 1.2;
      letter-spacing: -0.5px;
    }

    /* Buttons section */
    .buttons-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 24px 60px;
    }

    .buttons {
      width: 100%;
      max-width: 420px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .link-btn {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
      height: 60px;
      padding: 0 20px;
      background: #f0ece3;
      border: 2px solid #111111;
      border-radius: 100px;
      text-decoration: none;
      color: #111111;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.2px;
      transition: background 0.15s ease;
      cursor: pointer;
    }
    .link-btn:hover { background: #e8e4db; }
    .link-btn:active { background: #ddd9d0; }

    /* black circle icon on the left */
    .icon-wrap {
      position: absolute;
      left: 14px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #111111;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .icon-wrap svg {
      width: 20px;
      height: 20px;
      display: block;
      fill: white;
    }

    /* text perfectly centered in the full button width */
    .btn-text {
      width: 100%;
      text-align: center;
    }

    .empty {
      text-align: center;
      color: #aaa;
      margin-top: 40px;
      font-size: 14px;
      line-height: 2.2;
    }
    .empty strong { color: #555; }

    .footer {
      margin-top: 40px;
      font-size: 13px;
      font-weight: 700;
      color: #111;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  </style>
</head>
<body>

  <div class="hero">
    <div class="hero-inner" id="heroInner">
      <div class="logo">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 183.8 94" aria-label="AllyAlways">
          <path fill="#32bebc" d="M180.1,64.6V27.8c0-1.3-.6-2.1-2-2.1h-6.1c-1.2,0-1.8.8-1.8,2.2v3.4c0,12.5-5.4,28-13.5,28s-6-3.8-6-9,.4-16.8.4-22.3-.6-2.2-1.9-2.2h-5.9c-1.2,0-2,.7-2,2.2v19.7c-2.4,5.7-7.6,12.2-17,12.2s-13.8-6.1-13.8-15.5v-4.9c12.7-3.8,24-13.3,24-24.4s-5.2-13.2-13.4-13.2c-13.6,0-19.8,14.4-19.8,31.3v11.5c0,1.3,0,2.5.2,3.8-2.5,5.5-7.7,11.5-16.7,11.5s-13.8-6.1-13.8-15.5v-4.9c12.7-3.8,24-13.3,24-24.4s-5.2-13.2-13.4-13.2c-13.6,0-19.8,14.4-19.8,31.3v11.5c0,.9,0,1.8.1,2.7-2.1,5.2-6.3,11.9-11.5,11.9s-5.5-3.6-5.5-8.2c0-7.3,1.1-21.5,1.1-23.2s-.7-2.1-1.9-2.1h-5.8c-1.1,0-1.8.7-1.8,2v1.7l-.4.2c-3-2.7-7.3-5-13.1-5-11.5,0-19.7,9.6-19.7,22.3s7.3,20.8,17.5,20.8,13.7-5.3,15.9-10.5h.4v1.5c0,5.5,4.6,9,11.1,9s13.3-5.2,16.6-10.5c3.5,6.6,10,10.5,18.6,10.5s16.7-4.2,21-10.3c3.5,6.4,9.9,10.3,18.5,10.3s15.1-3.4,19.5-8.4c1.8,5.4,6,8.4,12,8.4,8.6,0,14.2-6.5,16.6-12.9h.4c0,0,0,9.4,0,9.4,0,13.7-6.1,18.3-13,18.3s-6.6-1.9-8.6-3.5c-.8-.6-1.2-.9-1.6-.9-1.3,0-4.6,4.5-4.6,5.9,0,2.2,6,7.1,14.3,7.1,14.9,0,22.5-10.2,22.5-26.5ZM120.8,9.7c3.2,0,5,2.3,5,5.4,0,7.3-8.7,13.6-15.4,16,.3-10,3.5-21.4,10.4-21.4ZM81.3,9.7c3.2,0,5,2.3,5,5.4,0,7.3-8.7,13.6-15.4,16,.3-10,3.5-21.4,10.4-21.4ZM22.6,59.3c-5.4,0-9.5-4.7-9.5-11.9s5.4-14.2,12.7-14.2,8.4,2.6,10.4,4.7c0,7.8-4.1,21.4-13.7,21.4Z"/>
        </svg>
      </div>
      <div class="heading">Welcome!<br>Let's get to it.</div>
    </div>
  </div>

  <div class="buttons-section">
  <div class="buttons">

    <% if (links.length === 0) { %>
    <div class="empty">No links yet.<br>Add them at /admin<br>using prefix: <strong>contact</strong></div>
    <% } %>

    <% links.forEach(function(link) {
      var s = link.slug.toLowerCase()
      var isFacebook   = s.includes('facebook') || s === 'fb'
      var isInstagram  = s.includes('instagram') || s === 'ig'
      var isTiktokShop = s.includes('tiktokshop') || s.includes('ttshop') || s.includes('tiktok-shop')
      var isTiktok     = !isTiktokShop && (s.includes('tiktok') || s === 'tt')
      var isShopee     = s.includes('shopee')
      var isLazada     = s.includes('lazada')
      var isLine       = s.includes('line')
      var isYoutube    = s.includes('youtube') || s === 'yt'
    %>

    <a href="<%= link.url %>" target="_blank" rel="noopener" class="link-btn">

      <% if (isFacebook) { %>
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </div>

      <% } else if (isInstagram) { %>
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </div>

      <% } else if (isTiktokShop) { %>
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9.05a8.16 8.16 0 004.77 1.52V7.12a4.85 4.85 0 01-1-.43z"/><path d="M8 18h8v1.5H8zm1-3h6v1.5H9z" opacity=".6"/></svg>
      </div>

      <% } else if (isTiktok) { %>
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9.05a8.16 8.16 0 004.77 1.52V7.12a4.85 4.85 0 01-1-.43z"/></svg>
      </div>

      <% } else if (isShopee) { %>
      <div class="icon-wrap">
        <svg viewBox="0 0 64 64"><path fill="white" d="M32 4C16.536 4 4 16.536 4 32s12.536 28 28 28 28-12.536 28-28S47.464 4 32 4zm0 8c2.76 0 5 2.24 5 5s-2.24 5-5 5-5-2.24-5-5 2.24-5 5-5zm12 34H20l2-18h20l2 18z"/></svg>
      </div>

      <% } else if (isLazada) { %>
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24"><path fill="white" d="M4 4h7v7H4zm9 0h7v7h-7zM4 13h7v7H4zm9 2l3.5-3.5L20 15l-3.5 3.5z"/></svg>
      </div>

      <% } else if (isLine) { %>
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24"><path fill="white" d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.07 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
      </div>

      <% } else if (isYoutube) { %>
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24"><path fill="white" d="M23.495 6.205a3.007 3.007 0 00-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 00.527 6.205a31.247 31.247 0 00-.522 5.805 31.247 31.247 0 00.522 5.783 3.007 3.007 0 002.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 002.088-2.088 31.247 31.247 0 00.5-5.783 31.247 31.247 0 00-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/></svg>
      </div>

      <% } else { %>
      <div class="icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
      </div>
      <% } %>

      <span class="btn-text"><%= link.label || link.slug %></span>
    </a>

    <% }) %>
  </div>

  <% if (links.length > 0) { %>
  <a href="/" class="footer">Find us online</a>
  <% } %>
  </div><!-- /buttons-section -->

  <script>
    const hero = document.getElementById('heroInner')
    let ticking = false
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const y = window.scrollY
          hero.style.transform = `translateY(${y * 0.45}px)`
          hero.style.opacity = Math.max(0, 1 - y / 260)
          ticking = false
        })
        ticking = true
      }
    }, { passive: true })
  </script>

</body>
</html>
