  <script>
    const hero = document.getElementById('heroInner')
    const wrap = document.getElementById('pagesWrap')
    let ticking = false

    function goPage2() {
      wrap.classList.add('page2')
      window.scrollTo({ top: 0, behavior: 'smooth' })
    }
    function goPage1() {
      wrap.classList.remove('page2')
      window.scrollTo({ top: 0, behavior: 'smooth' })
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const y = window.scrollY
          hero.style.transform = `translateY(${y * 0.45}px)`
          hero.style.opacity = Math.max(0, 1 - y / 260)
          ticking = false
        })
        ticking = true
      }
    }, { passive: true })
  </script>

